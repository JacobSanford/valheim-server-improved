SERVER_NAME=My Valheim Server
WORLD_NAME=Dedicated
SERVER_PASS=changeme
SERVER_PORT=2456
SERVER_PUBLIC=true
CROSSPLAY=false
TZ=Etc/UTC
# Run as this user/group instead of the image's default of root
PUID=1000
PGID=1000
BACKUPS=true
# Keep backups for 30 days, but never fewer than the newest 3, however old.
# hooks/idle-backups.sh applies this; it needs the image's own age limit
# (BACKUPS_MAX_AGE, which can't keep a minimum) turned off with 36500 days.
BACKUPS_KEEP_DAYS=30
BACKUPS_KEEP_MIN=3
BACKUPS_MAX_AGE=36500
BACKUPS_MAX_COUNT=12
# Skip backups once nobody has played for an hour, so idle hours don't push out real ones
BACKUPS_IF_IDLE=false
# Check for game updates every 15 min; only apply when no players are online
UPDATE_CRON=*/15 * * * *
UPDATE_IF_IDLE=true
# Daily restart at 5:10 AM (skipped if players are online)
RESTART_CRON=10 5 * * *
RESTART_IF_IDLE=true
# Status page on container port 80 (mapped to 127.0.0.1:8456)
STATUS_HTTP=true
# Platform IDs such as Steam_<SteamID64>, space separated. Each one replaces the matching file in data/
#ADMINLIST_IDS=
#BANNEDLIST_IDS=
#PERMITTEDLIST_IDS=
# Notifications: all off until you list events here, comma separated:
#   server_up, server_down, restart, backup, player_spawned  (or: all)
NOTIFY_EVENTS=
# Discord: Server Settings > Integrations > Webhooks > Copy Webhook URL
NOTIFY_DISCORD_WEBHOOK=
#NOTIFY_DISCORD_USERNAME=
# Event hooks that feed notify/notify.sh and hooks/idle-backups.sh. To run your own command too,
# append "; your-command".
POST_SERVER_LISTENING_HOOK=/opt/notify/notify.sh server_up
PRE_SERVER_SHUTDOWN_HOOK=/opt/notify/notify.sh server_down
PRE_RESTART_HOOK=/opt/notify/notify.sh restart
# Deletes the previous backup if nobody played since it, then notifies (skipped when it deleted one)
POST_BACKUP_HOOK=/opt/hooks/idle-backups.sh prune @BACKUP_FILE@ && /opt/notify/notify.sh backup @BACKUP_FILE@ || true
VALHEIM_LOG_FILTER_CONTAINS_PlayerSpawned=Got character ZDOID from
ON_VALHEIM_LOG_FILTER_CONTAINS_PlayerSpawned=/opt/hooks/idle-backups.sh mark; /opt/notify/notify.sh player_spawned
# The game logs "Connections <players> ZDOS:..." every 10 minutes; feeds hooks/idle-backups.sh
VALHEIM_LOG_FILTER_CONTAINS_PlayerCount=ZDOS:
ON_VALHEIM_LOG_FILTER_CONTAINS_PlayerCount=/opt/hooks/idle-backups.sh connections
# Sleep when idle: stop the server when nobody is playing, start it on the next
# connection attempt. Off by default; see the Sleep When Idle guide first.
SLEEP_WHEN_IDLE=false
# stop (frees memory, ~1 min wake) or pause (keeps memory, instant wake)
#SLEEP_METHOD=stop
# Seconds with too little traffic before sleeping. Keep above 900 so an update check runs first.
#SLEEP_AFTER_SECONDS=1200
# Packets on 2456-2457 within that time that count as activity, and that wake the server
#SLEEP_MIN_PACKETS=10
